.{
    .name = .zmetal,
    .version = "0.0.0",
    .dependencies = .{
        .microzig = .{ .path = "lib/microzig" },
        .ClockHelper = .{
            .url = "git+https://github.com/ZigEmbeddedGroup/ClockHelper#922c35eb54f0417318ccfcc32367bdcf11823ede",
            .hash = "ClockHelper-2.0.0-RcMaOUMGIwEUEHQJ0C2Q-KbWdKXN2GqzQcs9MpVSTgm3",
        },
        .zfat = .{ .path = "lib/zfat" },
    },
    .fingerprint = 0x1d3b8cd0d48d17d2, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",

    // This field is optional.
    // Each dependency must either provide a `url` and `hash`, or a `path`.
    // `zig build --fetch` can be used to fetch all dependencies of a package, recursively.
    // Once all dependencies are fetched, `zig build` no longer requires
    // internet connectivity.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        // For example...
        //"LICENSE",
        //"README.md",
    },
}
